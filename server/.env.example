# Copy this file to .env and fill in real values. .env is gitignored.

# ── MySQL connection ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agro_buddy

# ── Auth ───────────────────────────────────────────────────────────────────────
# Any long random string. Rotating this logs every user out.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
# The frontend's origin, so CORS knows what to allow.
CLIENT_URL=http://localhost:3000
