# Copy this file to .env and fill in real values. .env is gitignored.

# ── MySQL connection ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agro_buddy

# ── Auth ───────────────────────────────────────────────────────────────────────
# Any long random string. Rotating this logs every user out.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
# The frontend's origin, so CORS knows what to allow. Also used to build the
# email-verification and password-reset links sent to users.
CLIENT_URL=http://localhost:3000

# ── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# Used to send verification and password-reset emails. GMAIL_APP_PASSWORD is
# NOT your regular Gmail password — generate a 16-character app password at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification to
# be turned on for the Google account first).
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# ── SSLCommerz (online payment) ─────────────────────────────────────────────
# Sandbox credentials: register at https://developer.sslcommerz.com/registration/
# SSLCZ_IS_LIVE must stay "false" until you have real (live) store credentials.
SSLCZ_STORE_ID=your-sandbox-store-id
SSLCZ_STORE_PASSWORD=your-sandbox-store-password
SSLCZ_IS_LIVE=false
# Must be a publicly reachable URL for SSLCommerz's server-to-server IPN call
# to reach /api/payments/ipn (localhost will not work for that one callback —
# use a tunnel like ngrok during local testing). success/fail/cancel are hit
# by the buyer's own browser, so localhost is fine for those.
SERVER_BASE_URL=http://localhost:5000
